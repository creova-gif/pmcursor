# PMCursor container environment configuration (placeholder-only; do NOT commit real secrets).
# Copy to `.env` for local overrides.

# Authentication & Webhook Secrets (leave empty here; set strong values in .env or secret manager)
PMCURSOR_API_TOKEN=
PMCURSOR_WEBHOOK_SECRET=
PMCURSOR_LINEAR_WEBHOOK_SECRET=
PMCURSOR_JIRA_WEBHOOK_SECRET=

# Rate limiting, proxy, CORS, and worker concurrency
PMCURSOR_RATE_LIMIT_PER_MIN=120
PMCURSOR_TRUST_PROXY=false
PMCURSOR_CORS_ORIGINS=
WEB_CONCURRENCY=1
