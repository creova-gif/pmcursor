# PMCursor environment configuration (placeholder-only; do NOT commit real secrets).
# Copy to `.env` for local overrides. All values also readable via process env.

# ── Authentication & webhook secrets ──────────────────────────────────────────
# Bearer token for /v1/* admin access. REQUIRED when binding non-loopback hosts.
PMCURSOR_API_TOKEN=
# HMAC-SHA256 secrets for provider webhook signature verification.
PMCURSOR_WEBHOOK_SECRET=
PMCURSOR_LINEAR_WEBHOOK_SECRET=
PMCURSOR_JIRA_WEBHOOK_SECRET=

# ── Tenancy (per-org API keys; see `pmcursor orgs`, ADR-006/007) ───────────────
# Path to the org registry store. When set, `pmk_...` org keys authenticate
# alongside PMCURSOR_API_TOKEN, with per-org rate-limit buckets and cache scopes.
PMCURSOR_ORG_STORE=
# Backend for the org store: `file` (default, single-writer JSON) or `sqlite`
# (WAL + busy_timeout — required for WEB_CONCURRENCY>1 or multi-process writes).
# sqlite expects its own store path (e.g. /orgs/orgs.db); a JSON store is not imported.
PMCURSOR_ORG_BACKEND=file

# ── Rate limiting, proxy, CORS, worker concurrency ────────────────────────────
PMCURSOR_RATE_LIMIT_PER_MIN=120
PMCURSOR_TRUST_PROXY=false
PMCURSOR_CORS_ORIGINS=
WEB_CONCURRENCY=1

# ── LLM summaries (pmcursor summarize, /v1/summarize) ─────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub App (manifest flow, installation tokens, PR automation) ─────────────
PMCURSOR_GITHUB_APP_ID=
PMCURSOR_GITHUB_APP_PRIVATE_KEY=
PMCURSOR_GITHUB_APP_PRIVATE_KEY_PATH=
# GitHub Enterprise Server API base (default https://api.github.com).
PMCURSOR_GITHUB_API_BASE=
# Set to 0 to disable webhook-driven PR automation / failure comments.
PMCURSOR_GITHUB_APP_AUTO_RUN=1
PMCURSOR_GITHUB_APP_PR_COMMENTS=1
# Spec file path override for PR automation (default: candidate search).
PMCURSOR_PRD_PATH=
# Personal token for `pmcursor publish` / CLI GitHub calls.
PMCURSOR_GITHUB_TOKEN=
GITHUB_TOKEN=

# ── Telemetry connectors (telemetry-verify --source) ──────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PMCURSOR_BQ_PROJECT=
PMCURSOR_BQ_DATASET=
PMCURSOR_BQ_TABLE=

# ── Ticket sync (ticket-sync) ─────────────────────────────────────────────────
LINEAR_API_KEY=
PMCURSOR_LINEAR_API_KEY=
JIRA_API_TOKEN=
PMCURSOR_JIRA_API_TOKEN=
PMCURSOR_JIRA_BASE_URL=
